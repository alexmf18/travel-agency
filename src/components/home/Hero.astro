---
import Icon from '../Icon.astro';
import { heroSlides } from '../../data/site';
import { trips } from '../../data/trips';
import { responsive } from '../../lib/imagenes';

const ANCHOS = [640, 1024, 1600, 2400];

// Cifras sacadas del catálogo para que el texto no se quede desactualizado.
const dias = trips.map((t) => t.dias);
const grupoMax = Math.max(...trips.map((t) => t.grupoMax));
const pad = (n: number) => String(n).padStart(2, '0');
---

<section
  id="inicio"
  class="relative min-h-[100dvh] overflow-hidden bg-sumi text-white"
  aria-roledescription="carrusel"
  aria-label="Imágenes de Japón"
>
  <div class="absolute inset-0">
    {heroSlides.map((slide, i) => {
      const img = responsive(slide.src, ANCHOS, '100vw');
      return (
        <div
          class:list={['hero-slide absolute inset-0', { active: i === 0 }]}
          aria-roledescription="diapositiva"
          aria-label={`${i + 1} de ${heroSlides.length}: ${slide.alt}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          data-caption={slide.alt}
        >
          <img
            src={img.src}
            srcset={img.srcset}
            sizes={img.sizes}
            alt={slide.alt}
            class="w-full h-full object-cover"
            decoding="async"
            {...(i === 0 ? { fetchpriority: 'high' } : { loading: 'lazy' })}
          />
        </div>
      );
    })}
    <!-- Velo: oscurece abajo a la izquierda, donde va el texto. -->
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-black/35"></div>
    <div class="absolute inset-0 bg-linear-to-r from-black/45 to-transparent"></div>
  </div>

  <div class="relative z-10 wrap min-h-[100dvh] flex flex-col justify-end pt-28 pb-32 md:pb-28">
    <p class="flex items-center gap-2 text-sm font-medium text-white/85 mb-6">
      <span class="w-2 h-2 rounded-full bg-accent" aria-hidden="true"></span>
      Viajes en grupo con guía en español
    </p>
    <h1 class="font-display font-semibold text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] leading-[0.98] max-w-4xl">
      Descubre Japón con quien lo conoce.
    </h1>
    <p class="mt-6 text-lg md:text-xl text-white/85 max-w-xl leading-relaxed">
      Rutas de {Math.min(...dias)} a {Math.max(...dias)} días por Tokio, Kioto, Osaka y el monte Fuji, en grupos de{' '}
      {grupoMax} personas como máximo.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="#viajes" class="btn btn-primary btn-lg">
        Ver viajes <Icon name="arrow-right" />
      </a>
      <a href="#contacto" class="btn btn-on-image btn-lg">Hablar con un asesor</a>
    </div>
  </div>

  <div class="absolute z-20 bottom-6 md:bottom-8 inset-x-0">
    <div class="wrap flex items-center justify-end gap-4">
      <p class="hidden sm:block text-xs text-white/75 tabular-nums mr-auto md:mr-0" aria-hidden="true">
        <span class="hero-counter">{pad(1)}</span> / {pad(heroSlides.length)}
        <span class="mx-1.5 opacity-60">·</span>
        <span class="hero-caption">{heroSlides[0].alt}</span>
      </p>
      <div class="flex items-center gap-1.5">
        {heroSlides.map((slide, i) => (
          <button class="carousel-indicator" data-slide={i} aria-label={`Ir a la imagen ${i + 1}: ${slide.alt}`}>
            <span></span>
          </button>
        ))}
      </div>
      <div class="flex items-center gap-2">
        <button class="carousel-btn carousel-prev hidden sm:inline-flex" aria-label="Imagen anterior">
          <Icon name="caret-left" />
        </button>
        <button class="carousel-btn carousel-pause" aria-label="Pausar carrusel">
          <Icon name="pause-fill" class="icon-pausa" />
          <Icon name="play-fill" class="icon-play hidden" />
        </button>
        <button class="carousel-btn carousel-next hidden sm:inline-flex" aria-label="Siguiente imagen">
          <Icon name="caret-right" />
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    .hero-slide {
      display: none;
      animation: fadeIn 0.8s var(--ease-out);
    }

    .hero-slide.active {
      display: block;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    /* Zona táctil de 24px con una barra fina dentro. */
    .carousel-indicator {
      width: 1.75rem;
      height: 1.5rem;
      display: inline-flex;
      align-items: center;
    }

    .carousel-indicator span {
      width: 100%;
      height: 3px;
      border-radius: 999px;
      background: rgb(255 255 255 / 0.4);
      transition: background-color 0.3s ease;
    }

    .carousel-indicator:hover span {
      background: rgb(255 255 255 / 0.7);
    }

    .carousel-indicator[aria-current='true'] span {
      background: #fff;
    }

    .carousel-btn {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 999px;
      align-items: center;
      justify-content: center;
      border: 1px solid rgb(255 255 255 / 0.4);
      color: #fff;
      background: rgb(0 0 0 / 0.25);
      backdrop-filter: blur(8px);
    }

    .carousel-pause {
      display: inline-flex;
    }

    .carousel-btn:hover {
      background: rgb(0 0 0 / 0.5);
      border-color: #fff;
    }

    .carousel-btn:active {
      transform: scale(0.95);
    }
  }
</style>

<script>
  const hero = document.getElementById('inicio');
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  const indicators = document.querySelectorAll<HTMLElement>('.carousel-indicator');
  const pauseBtn = hero?.querySelector<HTMLButtonElement>('.carousel-pause');
  const contador = hero?.querySelector('.hero-counter');
  const leyenda = hero?.querySelector('.hero-caption');

  let current = 0;
  let timer: ReturnType<typeof setInterval> | null = null;
  let touchStartX = 0;
  // Pausa elegida por el usuario (o por preferir menos movimiento): el hover no la reanuda.
  let pausadoPorUsuario = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let enPantalla = true;

  function showSlide(index: number) {
    current = (index + slides.length) % slides.length;
    slides.forEach((slide, i) => {
      slide.classList.toggle('active', i === current);
      if (i === current) slide.removeAttribute('aria-hidden');
      else slide.setAttribute('aria-hidden', 'true');
    });
    indicators.forEach((indicator, i) => indicator.setAttribute('aria-current', String(i === current)));
    if (contador) contador.textContent = String(current + 1).padStart(2, '0');
    if (leyenda) leyenda.textContent = slides[current].dataset.caption ?? '';
  }

  function start() {
    if (timer || pausadoPorUsuario || !enPantalla || document.hidden) return;
    timer = setInterval(() => showSlide(current + 1), 5000);
  }

  function stop() {
    if (timer) clearInterval(timer);
    timer = null;
  }

  function actualizarBotonPausa() {
    if (!pauseBtn) return;
    pauseBtn.setAttribute('aria-label', pausadoPorUsuario ? 'Reanudar carrusel' : 'Pausar carrusel');
    pauseBtn.querySelector('.icon-pausa')?.classList.toggle('hidden', pausadoPorUsuario);
    pauseBtn.querySelector('.icon-play')?.classList.toggle('hidden', !pausadoPorUsuario);
  }

  /** Cambia de imagen a mano y reinicia el temporizador. */
  function goTo(index: number) {
    showSlide(index);
    stop();
    start();
  }

  if (hero && slides.length) {
    showSlide(0);
    actualizarBotonPausa();
    start();

    indicators.forEach((indicator, i) => indicator.addEventListener('click', () => goTo(i)));
    hero.querySelector('.carousel-prev')?.addEventListener('click', () => goTo(current - 1));
    hero.querySelector('.carousel-next')?.addEventListener('click', () => goTo(current + 1));
    pauseBtn?.addEventListener('click', () => {
      pausadoPorUsuario = !pausadoPorUsuario;
      actualizarBotonPausa();
      if (pausadoPorUsuario) stop();
      else start();
    });

    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', start);

    // Sin animar cuando el hero no se ve o la pestaña está en segundo plano.
    new IntersectionObserver(([entry]) => {
      enPantalla = entry.isIntersecting;
      if (enPantalla) start();
      else stop();
    }).observe(hero);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    hero.addEventListener('touchstart', (e) => (touchStartX = e.changedTouches[0].screenX), { passive: true });
    hero.addEventListener(
      'touchend',
      (e) => {
        const delta = e.changedTouches[0].screenX - touchStartX;
        if (Math.abs(delta) < 35) return;
        goTo(delta < 0 ? current + 1 : current - 1);
      },
      { passive: true },
    );
  }
</script>
