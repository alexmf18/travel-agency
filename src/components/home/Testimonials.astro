---
import { testimonios } from '../../data/site';
---

<section id="testimonios" class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">LO QUE DICEN NUESTROS CLIENTES</h2>
      <p class="text-xl text-gray-600">Experiencias reales de viajeros satisfechos</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonios.map((t) => (
        <div class="bg-gray-50 p-8 rounded-lg shadow-lg">
          <div class="flex items-center mb-4">
            <div class="text-yellow-500 text-xl" role="img" aria-label="5 de 5 estrellas">
              {Array.from({ length: 5 }, () => (
                <>
                  <i class="fas fa-star"></i>{' '}
                </>
              ))}
            </div>
          </div>
          <p class="text-gray-700 mb-6 italic">"{t.texto}"</p>
          <div class="flex items-center">
            <div class="w-12 h-12 bg-red-500 rounded-full flex items-center justify-center text-white font-bold text-xl">
              {t.nombre[0]}
            </div>
            <div class="ml-4">
              <div class="font-bold text-gray-800">{t.nombre}</div>
              <div class="text-sm text-gray-500">{t.ciudad}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
