---
import Icon from '../Icon.astro';
import type { Trip } from '../../data/types';
import { duracion, formatPrecio } from '../../lib/format';
import { estaCompleta, formatFecha } from '../../lib/salidas';
import { srcset, unsplash } from '../../lib/imagenes';

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;
const nombre = trip.nombreCorto ?? trip.nombre;
// El script de filtros recalcula la próxima salida en el navegador con la fecha real.
const disponibles = trip.salidas.filter((s) => !estaCompleta(s)).map((s) => s.fecha);
const valoracion = trip.valoracion.toLocaleString('es-ES', { minimumFractionDigits: 1 });
---

<a
  href={`/viajes/${trip.slug}/`}
  class="trip-card group block"
  data-reveal
  data-dias={trip.dias}
  data-precio={trip.precio}
  data-salidas={disponibles.join(',')}
>
  <div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-surface-2">
    <img
      src={unsplash(trip.tarjeta.imagen, 800, 600)}
      srcset={srcset(trip.tarjeta.imagen, [480, 800, 1200], 0.75)}
      sizes="(min-width: 1280px) 600px, (min-width: 768px) 50vw, 100vw"
      alt=""
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
    />
    <span
      class="absolute top-4 left-4 rounded-full bg-black/45 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1.5"
    >
      {duracion(trip)}
    </span>
    <span
      class="absolute bottom-4 right-4 w-11 h-11 rounded-full bg-white text-sumi flex items-center justify-center text-lg shadow-card transition-transform group-hover:-rotate-45"
      aria-hidden="true"
    >
      <Icon name="arrow-right" />
    </span>
  </div>

  <div class="pt-5 flex items-start justify-between gap-6">
    <div class="min-w-0">
      <h3 class="text-2xl md:text-3xl font-semibold group-hover:text-accent-ink transition-colors">{nombre}</h3>
      <p class="mt-2 text-ink-2 leading-relaxed max-w-[46ch]">{trip.tarjeta.descripcion}</p>
      <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-3">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="star-fill" class="text-accent" />
          <span><span class="text-ink font-medium">{valoracion}</span> ({trip.numResenas})</span>
        </span>
        <span class="inline-flex items-center gap-1.5" data-proxima>
          <Icon name="calendar-blank" />
          <span>
            Próxima salida:{' '}
            <span class="text-ink font-medium" data-proxima-fecha>
              {disponibles[0] ? formatFecha(disponibles[0]) : 'por confirmar'}
            </span>
          </span>
        </span>
      </p>
    </div>
    <div class="text-right shrink-0">
      <p class="text-xs text-ink-3">Desde</p>
      <p class="font-display text-2xl md:text-3xl font-semibold tabular-nums">{formatPrecio(trip.precio)}</p>
      <p class="text-xs text-ink-3">por persona</p>
    </div>
  </div>
</a>
