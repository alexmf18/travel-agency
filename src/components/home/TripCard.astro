---
import type { Trip } from '../../data/types';
import { duracion, formatPrecio } from '../../lib/format';

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;
const nombre = trip.nombreCorto ?? trip.nombre;
---

<a
  href={`/viajes/${trip.slug}`}
  class="block bg-white rounded-lg overflow-hidden shadow-lg card-hover"
>
  <img
    src={trip.tarjeta.imagen}
    alt={nombre}
    class="w-full h-64 object-cover"
    loading="lazy"
    decoding="async"
  />
  <div class="p-6">
    <h3 class="text-2xl font-bold text-gray-800 mb-2">{nombre}</h3>
    <p class="text-gray-600 mb-4">{trip.tarjeta.descripcion}</p>
    <div class="flex items-center justify-between">
      <span class="text-3xl font-bold text-red-600">{formatPrecio(trip.precio)}</span>
      <span class="text-sm text-gray-500">por persona</span>
    </div>
    <div class="mt-4 text-sm text-gray-500">
      <i class="fas fa-clock mr-2"></i>{duracion(trip, ' / ')}
    </div>
  </div>
</a>
