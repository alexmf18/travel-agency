---
import Icon from '../Icon.astro';
import type { Resena } from '../../data/types';

interface Props {
  resenas: Resena[];
  valoracion: number;
  numResenas: number;
}

const { resenas, valoracion, numResenas } = Astro.props;
const media = valoracion.toLocaleString('es-ES', { minimumFractionDigits: 1 });
---

<section aria-labelledby="opiniones">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <h2 id="opiniones" class="text-2xl md:text-3xl font-semibold">Opiniones de viajeros</h2>
    <p class="flex items-center gap-2 text-sm text-ink-3">
      <Icon name="star-fill" class="text-accent" />
      <span><span class="font-semibold text-ink">{media}</span> de 5 · {numResenas} reseñas</span>
    </p>
  </div>
  <div class="border-t border-line">
    {resenas.map((r) => (
      <figure class="flex gap-4 py-6 border-b border-line">
        <span class="w-11 h-11 rounded-full bg-surface-2 text-ink-2 flex items-center justify-center font-semibold text-sm shrink-0">
          {r.iniciales}
        </span>
        <div class="flex-1 min-w-0">
          <figcaption class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2">
            <span class="font-semibold">{r.nombre}</span>
            <span class="flex text-sm" role="img" aria-label={`${r.estrellas} de 5 estrellas`}>
              {Array.from({ length: 5 }, (_, i) => (
                <Icon name="star-fill" class={i < r.estrellas ? 'text-accent' : 'text-line-strong'} />
              ))}
            </span>
            <span class="text-sm text-ink-3">{r.fecha}</span>
          </figcaption>
          <blockquote class="text-ink-2 leading-relaxed">{r.texto}</blockquote>
        </div>
      </figure>
    ))}
  </div>
</section>
