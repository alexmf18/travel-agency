---
/**
 * Icono de Phosphor (https://phosphoricons.com) como SVG en línea.
 * Se resuelve al generar la página: no se envía ninguna fuente de iconos al navegador.
 * En las islas de React se usa @phosphor-icons/react, de la misma familia.
 */
import { icons } from '@iconify-json/ph';
import { getIconData, iconToSVG } from '@iconify/utils';

interface Props {
  /** Nombre del icono, p. ej. `airplane` o `star-fill`. */
  name: string;
  class?: string;
  /** Texto para lectores de pantalla; sin él, el icono es decorativo. */
  label?: string;
  /** Atributos data-* para localizar el icono desde un script. */
  [data: `data-${string}`]: string | boolean;
}

const { name, class: className, label, ...datos } = Astro.props;
const data = getIconData(icons, name);
if (!data) throw new Error(`Icono de Phosphor desconocido: "${name}"`);
const { attributes, body } = iconToSVG(data);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={attributes.viewBox}
  width="1em"
  height="1em"
  fill="currentColor"
  class:list={['icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...datos}
  set:html={body}
/>
