---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  isHome?: boolean;
  newsletter?: boolean;
  footerClass?: string;
}

const { title, description, image, noindex, jsonLd, isHome = false, newsletter = false, footerClass } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <!-- Antes de pintar: tema guardado o, si no hay, el del sistema. Evita el destello claro. -->
    <script is:inline>
      (() => {
        let tema = null;
        try {
          tema = localStorage.getItem('tema');
        } catch {}
        const oscuro = tema ? tema === 'oscuro' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = oscuro ? 'dark' : 'light';
      })();
    </script>
    <Seo title={title} description={description} image={image} noindex={noindex} jsonLd={jsonLd} />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido principal</a>
    <Navbar isHome={isHome} />
    <main id="contenido">
      <slot />
    </main>
    <Footer isHome={isHome} newsletter={newsletter} class={footerClass} />
    <slot name="after-footer" />
  </body>
</html>
